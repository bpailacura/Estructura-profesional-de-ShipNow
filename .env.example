# Obligatorias: la app no arranca si falta alguna (ver src/config/env.config.js)
PORT=3000
MONGODB_URI=mongodb://localhost:27017/shipnow
NODE_ENV=development

# Opcionales: la app arranca igual si faltan, usando su default.
# JWT_SECRET: no se usa hoy en el flujo de negocio (no hay login con JWT
# implementado en esta versión), se deja preparada para cuando se agregue.
JWT_SECRET=

# LOG_LEVEL: fatal | error | warning | info | http | debug
# Si no se setea (o el valor no es válido) usa: debug en development/test, info en production.
LOG_LEVEL=debug

# Nota: ShipNow no consume APIs externas en esta versión (no hay pasarela
# de pago, servicio de geolocalización, etc.), por eso no hay variables de
# tipo *_SERVICE_URL acá. El día que se integre alguna, va en este archivo.
